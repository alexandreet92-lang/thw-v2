# Supabase — trouvables dans Settings > API de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clé secrète pour protéger l'endpoint POST /api/questionnaire
# Générer avec : openssl rand -hex 32
# À configurer aussi dans Vercel > Environment Variables
QUESTIONNAIRE_API_KEY=your-secret-api-key

# EmailJS — trouvables dans le dashboard EmailJS
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key
